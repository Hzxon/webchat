{
  "name": "webchat",
  "version": "0.6.1",
  "private": true,
  "description": "Self-hosted web chat for friends with realtime and push notifications",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && npm run build:client && npm run build:plugin && tsc -p tsconfig.server.json && cp -R server/migrations dist/server/",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.tools.json",
    "test": "node --test --test-concurrency=1 --test-timeout=15000 --import tsx test/*.test.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "agent": "tsx agent/index.ts",
    "build:client": "vite build && vite build --config vite.sw.config.ts",
    "build:plugin": "vite build --config vite.plugin.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@vercel/functions": "^3.10.5",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "http_ece": "^1.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
