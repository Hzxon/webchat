# Copy to .env and adjust, or set these in your host's environment (on Vercel: Project Settings >
# Environment Variables). The server reads environment variables only; it does not load .env itself.
# Example: node --env-file=.env dist/server/index.js

# Postgres connection string. On Vercel, the Supabase integration sets POSTGRES_URL, which is also
# read. Use Supabase's transaction pooler (port 6543) for serverless.
# When neither is set, an embedded PGlite database in PGLITE_DIR is used (local development).
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Supabase's root CA certificate (Dashboard > Database Settings > SSL Configuration), with newlines
# written as \n. Without it the connection is still encrypted but the server is not verified.
DATABASE_CA_CERT=

# Code friends must enter to create an account. If unset, one is generated on first start, saved in
# the database, and printed in the server log. Set it explicitly on Vercel.
INVITE_CODE=

# Web Push keys. If unset, they are generated once and saved in the database. Set them explicitly
# on Vercel, and never change them: that breaks every existing push subscription.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact for push services: a mailto: address or your site's https URL. Safari rejects localhost.
VAPID_SUBJECT=https://your-app.vercel.app

# Local server only. Vercel sets these for you.
PORT=3000
HOST=0.0.0.0
# Set to 1 when running behind a reverse proxy that terminates HTTPS.
TRUST_PROXY=

SESSION_DAYS=30

# Pull requests pane (optional). Create an OAuth App at https://github.com/settings/developers with the
# callback URL https://your-app.vercel.app/api/github/callback, and set its client ID and secret.
# The secret also encrypts the stored GitHub tokens: changing it makes everyone connect again.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only when the server sees another address than the browser, such as behind a proxy that changes
# the Host header. Must match the OAuth App's callback URL.
GITHUB_CALLBACK_URL=
# Project repositories (optional). Create a GitHub App at https://github.com/settings/apps/new as the
# README describes, with the callback URL https://your-app.vercel.app/api/github/app/callback, the
# Setup URL https://your-app.vercel.app/api/github/app/setup and the webhook URL
# https://your-app.vercel.app/api/github/webhook. Linking stays off until all four are set.
# The name in the app's URL on GitHub, such as webchat-for-capstone.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The webhook secret set on the app. GitHub signs every webhook with it.
GITHUB_WEBHOOK_SECRET=
# Only when the server sees another address than the browser. Must be one of the app's callback URLs.
GITHUB_APP_CALLBACK_URL=
# How often a self-hosted server checks every connected account, in seconds. 0 turns it off.
# Ignored on Vercel, where a scheduler calls /api/github/poll instead (see README).
GITHUB_POLL_SECONDS=120
# Bearer token that GET /api/github/poll requires. Vercel Cron sends it by itself.
CRON_SECRET=
# Names the running build, so open tabs reload when it changes. Vercel sets it from the deployment.
# Elsewhere, leave it empty and the built page is hashed instead.
WEBCHAT_BUILD=
