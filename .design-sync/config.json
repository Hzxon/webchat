{
  "pkg": "@webchat/board-kit",
  "globalName": "WebchatBoard",
  "projectId": "6a3de211-0e03-4904-9467-24da6c9a40e0",
  "shape": "package",
  "buildCmd": "npm run build:board-kit",
  "cssEntry": "dist/style.css",
  "provider": {
    "component": "BoardTheme"
  },
  "componentSrcMap": {
    "BellIcon": null,
    "FileIcon": null,
    "HistoryIcon": null,
    "PencilIcon": null,
    "PlayIcon": null,
    "StopIcon": null,
    "TrashIcon": null
  },
  "overrides": {
    "Banner": {
      "cardMode": "column"
    },
    "BoardDrawer": {
      "cardMode": "column"
    },
    "BoardLanes": {
      "cardMode": "single",
      "primaryStory": "Roadmap",
      "viewport": "960x300"
    },
    "BoardTheme": {
      "cardMode": "single",
      "primaryStory": "Light",
      "viewport": "960x420"
    },
    "CardFace": {
      "cardMode": "column"
    },
    "CardPeek": {
      "cardMode": "single",
      "primaryStory": "WithRun",
      "viewport": "1280x760"
    },
    "Markdown": {
      "cardMode": "column"
    },
    "NeedsRow": {
      "cardMode": "column"
    },
    "ProposalFace": {
      "cardMode": "column"
    },
    "RunAsk": {
      "cardMode": "column"
    },
    "RunPanel": {
      "cardMode": "column"
    },
    "RunStep": {
      "cardMode": "column"
    },
    "Text": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
